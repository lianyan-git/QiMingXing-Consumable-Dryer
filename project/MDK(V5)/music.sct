; ******************************************************************
; * Music firmware image: MUB1 container at FIXED addresses
; * 5-track: HDR@0x00(36B) ENT@0x24(16*5=80B) NAME@0x74(64*5=320B) NOTES@0x1B4(...)
; * Generated by tools/gen_music_fw.py (from tools/music/music_pack.mub)
; * The generated Music.bin can be uploaded on the device
; * "Music -> Upload Music" web page into external flash.
; ******************************************************************

LR_MUSIC 0x08000000 0x00200000
{
    ER_HDR   0x08000000 0x00000024 { *(MUS_HDR) }
    ER_ENT   0x08000024 0x00000050 { *(MUS_ENT) }
    ER_NAME  0x08000074 0x00000140 { *(MUS_NAME) }
    ER_NOTES 0x080001B4 0x001FFE4C { *(MUS_NOTES) }
}
